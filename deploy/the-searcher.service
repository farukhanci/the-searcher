[Unit]
Description=The Searcher — web research for the Sentinel
Documentation=https://github.com/farukhanci/the-searcher
# Ollama is a system service; a user unit cannot order itself against it, so
# the restart loop below is what actually handles Ollama not being up yet.
After=network-online.target

# If Ollama is not up yet at boot, the first few starts fail. Keep trying for
# five minutes rather than giving up. These belong in [Unit] - systemd ignores
# them under [Service].
StartLimitBurst=60
StartLimitIntervalSec=300

[Service]
Type=exec
WorkingDirectory=%h/the-searcher

# The venv's python is used directly, so the unit does not depend on the shell
# activating anything. This is why forgetting `source activate` stops mattering.
#
# --host 0.0.0.0 because Open WebUI runs in a container and reaches this
# through host.docker.internal, which loopback does not answer. Bound to the
# machine, published nowhere.
ExecStart=%h/.venvs/searcher/bin/uvicorn serve:app --host 0.0.0.0 --port 8199

Environment=PYTHONUNBUFFERED=1

Restart=on-failure
RestartSec=5

# A research run holds the GPU for a while; do not kill it mid-read.
TimeoutStopSec=60

[Install]
WantedBy=default.target
